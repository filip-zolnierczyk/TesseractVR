{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vulkan-windows-x64",
      "displayName": "Windows x64 (Visual Studio + vcpkg)",
      "description": "Standardowa konfiguracja kompilacji z użyciem vcpkg dla całego zespołu",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build-vs",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "android-quest2",
      "displayName": "Meta Quest 2 (Android arm64)",
      "description": "Konfiguracja natywnego buildu Vulkan/OpenXR dla Oculus/Meta Quest 2",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-android",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android",
        "CMAKE_ANDROID_ARCH_ABI": "arm64-v8a",
        "CMAKE_SYSTEM_VERSION": "29",
        "CMAKE_ANDROID_NDK": "$env{ANDROID_NDK_ROOT}",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-android"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vulkan-windows-x64",
      "configuration": "Release"
    },
    {
      "name": "quest2-release",
      "configurePreset": "android-quest2",
      "configuration": "Release"
    }
  ]
}